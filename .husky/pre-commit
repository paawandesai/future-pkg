# Staged files only; target under 10 s.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (https://github.com/gitleaks/gitleaks/releases)" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner -l warn
scripts/check-staged-secrets.sh
pnpm exec lint-staged
