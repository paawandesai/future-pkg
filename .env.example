# Copy to .env and fill in locally. Never commit .env.
# Anthropic paid API key (read by name; never logged or sent to the browser)
ANTHROPIC_FUTURE_API_KEY=replace-me
# Model ids are configuration; check Anthropic's models and deprecations pages before changing
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_MAIN=claude-sonnet-5-5
# Optional: comma-separated models that get the server-side refusal fallback; "none" turns it off.
# Unset means the main model gets it.
# LLM_FALLBACK_MODELS=
# Date the synthetic member data is anchored to
AS_OF_DATE=2026-06-04
# mock is for local development only; the deployed config must use cognito
AUTH_MODE=mock

# ---- Optional; the defaults suit local development ----
# Used only when ANTHROPIC_FUTURE_API_KEY is unset.
# ANTHROPIC_API_KEY=
# Where the assessment data, rule files and generated fixtures live (defaults: data/, kg/, fixtures/)
# DATA_DIR=
# KG_DIR=
# FIXTURES_DIR=
# Local plan store (default .cache/plans.sqlite3); deployed plans go to DynamoDB instead
# PLAN_DB=
# Coach id the mock sign-in uses (default: the demo coach)
# DEMO_COACH_ID=
# Deployed only, set by the CDK stack: COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, PLAN_TABLE,
# ACCESS_TABLE, ANTHROPIC_SECRET_ID, ORIGIN_SECRET_ID, RATE_SALT.
