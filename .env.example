# Copy to .env and fill in locally. Never commit .env.
# Anthropic paid API key (read by name; never logged or sent to the browser)
ANTHROPIC_FUTURE_API_KEY=replace-me
# Model ids are configuration; check Anthropic's models and deprecations pages before changing
LLM_MODEL_FAST=replace-me
LLM_MODEL_MAIN=replace-me
# Date the synthetic member data is anchored to
AS_OF_DATE=2026-06-04
# mock is for local development only; the deployed config must use cognito
AUTH_MODE=mock
